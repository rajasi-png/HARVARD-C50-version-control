//right aligned pyramid
#include <cs50.h>
#include <stdio.h>

int main(void)
{
    int n;
    do
    {
        n = get_int("Whats the number of rows? ");
    }
    while (n <= 0 || n >= 9);

    for (int i = 0; i < n; i++)
    {

        for (int s = 0; s < n - (i + 1); s++)
        {
            printf(" ");
        }
        
        for (int j = 0; j < i + 1; j++)
        {
            printf("#");
        }
        printf("\n");
    }
}
